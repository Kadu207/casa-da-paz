{
  "name": "Casa da Paz - Tarefa Delegacao",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "casadapaz-tarefa-delegacao",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "d1-webhook-delegacao",
      "name": "Webhook Tarefa Delegacao",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "casadapaz-tarefa-delegacao"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ev1",
              "name": "evento",
              "value": "={{ $json.workflow || 'tarefa_delegacao' }}",
              "type": "string"
            },
            {
              "id": "t1",
              "name": "tarefaId",
              "value": "={{ $json.tarefaId }}",
              "type": "number"
            },
            {
              "id": "ti1",
              "name": "titulo",
              "value": "={{ $json.titulo || '' }}",
              "type": "string"
            },
            {
              "id": "f1",
              "name": "funcao",
              "value": "={{ $json.funcao || '' }}",
              "type": "string"
            },
            {
              "id": "p1",
              "name": "pessoaNome",
              "value": "={{ $json.pessoaNome || '' }}",
              "type": "string"
            },
            {
              "id": "tel1",
              "name": "telefone",
              "value": "={{ $json.telefone || '' }}",
              "type": "string"
            },
            {
              "id": "em1",
              "name": "email",
              "value": "={{ $json.email || '' }}",
              "type": "string"
            },
            {
              "id": "v1",
              "name": "vencimento",
              "value": "={{ $json.vencimento || '' }}",
              "type": "string"
            },
            {
              "id": "tp1",
              "name": "tipoEvento",
              "value": "={{ $json.tipoEvento || 'CRIADA' }}",
              "type": "string"
            },
            {
              "id": "c1",
              "name": "canal",
              "value": "={{ $json.canal || '' }}",
              "type": "string"
            },
            {
              "id": "m1",
              "name": "mensagem",
              "value": "={{ '[Casa da Paz] ' + ($json.funcao || '') + ' — ' + ($json.titulo || '') + ' (' + ($json.tipoEvento || '') + ')' + ($json.vencimento ? ' venc. ' + $json.vencimento : '') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "d2-set-delegacao",
      "name": "Normalizar payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "is-wa",
              "leftValue": "={{ $json.canal }}",
              "rightValue": "WHATSAPP",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d3-if-whatsapp",
      "name": "Canal WhatsApp?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "is-email",
              "leftValue": "={{ $json.canal }}",
              "rightValue": "EMAIL",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d4-if-email",
      "name": "Canal E-mail?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 420]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.CHATWOOT_PUBLIC_URL || 'http://localhost:3001').replace(/\\/$/, '') + '/api/v1/accounts/1/conversations' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "api_access_token",
              "value": "={{ $env.CHATWOOT_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"source_id\": \"{{ $json.telefone }}\",\n  \"inbox_id\": 1,\n  \"message\": { \"content\": \"{{ $json.mensagem }}\" }\n}",
        "options": {}
      },
      "id": "d5-chatwoot",
      "name": "Chatwoot WhatsApp (stub)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [980, 120],
      "disabled": true,
      "notes": "Ativar com CHATWOOT_API_TOKEN em produção."
    },
    {
      "parameters": {},
      "id": "d6-email-stub",
      "name": "Send Email (configurar SMTP)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [980, 420],
      "notes": "Substituir por nó Send Email (SMTP) com $json.email e $json.mensagem."
    },
    {
      "parameters": {},
      "id": "d7-noop",
      "name": "Outro canal (log)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [980, 300]
    }
  ],
  "connections": {
    "Webhook Tarefa Delegacao": {
      "main": [[{ "node": "Normalizar payload", "type": "main", "index": 0 }]]
    },
    "Normalizar payload": {
      "main": [
        [
          { "node": "Canal WhatsApp?", "type": "main", "index": 0 },
          { "node": "Canal E-mail?", "type": "main", "index": 0 }
        ]
      ]
    },
    "Canal WhatsApp?": {
      "main": [
        [{ "node": "Chatwoot WhatsApp (stub)", "type": "main", "index": 0 }],
        [{ "node": "Outro canal (log)", "type": "main", "index": 0 }]
      ]
    },
    "Canal E-mail?": {
      "main": [
        [{ "node": "Send Email (configurar SMTP)", "type": "main", "index": 0 }],
        [{ "node": "Outro canal (log)", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": true,
