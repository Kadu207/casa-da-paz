{
  "name": "Casa da Paz - Tarefa Delegacao",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "casadapaz-tarefa-delegacao",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "d1-webhook-delegacao",
      "name": "Webhook Tarefa Delegacao",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "casadapaz-tarefa-delegacao"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ev1",
              "name": "evento",
              "value": "={{ $json.workflow || 'tarefa_delegacao' }}",
              "type": "string"
            },
            {
              "id": "t1",
              "name": "tarefaId",
              "value": "={{ $json.tarefaId }}",
              "type": "number"
            },
            {
              "id": "ti1",
              "name": "titulo",
              "value": "={{ $json.titulo || '' }}",
              "type": "string"
            },
            {
              "id": "f1",
              "name": "funcao",
              "value": "={{ $json.funcao || '' }}",
              "type": "string"
            },
            {
              "id": "p1",
              "name": "pessoaNome",
              "value": "={{ $json.pessoaNome || '' }}",
              "type": "string"
            },
            {
              "id": "tel1",
              "name": "telefone",
              "value": "={{ $json.telefone || '' }}",
              "type": "string"
            },
            {
              "id": "em1",
              "name": "email",
              "value": "={{ $json.email || '' }}",
              "type": "string"
            },
            {
              "id": "v1",
              "name": "vencimento",
              "value": "={{ $json.vencimento || '' }}",
              "type": "string"
            },
            {
              "id": "tp1",
              "name": "tipoEvento",
              "value": "={{ $json.tipoEvento || 'CRIADA' }}",
              "type": "string"
            },
            {
              "id": "c1",
              "name": "canal",
              "value": "={{ $json.canal || '' }}",
              "type": "string"
            },
            {
              "id": "m1",
              "name": "mensagem",
              "value": "={{ '[Casa da Paz] ' + ($json.funcao || '') + ' — ' + ($json.titulo || '') + ' (' + ($json.tipoEvento || '') + ')' + ($json.vencimento ? ' venc. ' + $json.vencimento : '') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "d2-set-delegacao",
      "name": "Normalizar payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "is-wa",
              "leftValue": "={{ $json.canal }}",
              "rightValue": "WHATSAPP",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d3-if-whatsapp",
      "name": "Canal WhatsApp?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "is-email",
              "leftValue": "={{ $json.canal }}",
              "rightValue": "EMAIL",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d4-if-email",
      "name": "Canal E-mail?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 420]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.CHATWOOT_INTERNAL_URL || 'http://chatwoot:3000').replace(/\\/$/, '') + '/api/v1/accounts/' + ($env.CHATWOOT_ACCOUNT_ID || '1') + '/conversations' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "api_access_token",
              "value": "={{ $env.CHATWOOT_API_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"source_id\": \"{{ $json.telefone }}\",\n  \"inbox_id\": {{ Number($env.CHATWOOT_INBOX_ID || 1) }},\n  \"message\": { \"content\": \"{{ $json.mensagem }}\" }\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "d5-chatwoot",
      "name": "Chatwoot WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [980, 120],
      "notes": "Usa CHATWOOT_API_TOKEN + inbox WhatsApp. URL interna Docker chatwoot:3000."
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM || 'noreply@casadapaz.inovatitech.com.br' }}",
        "toEmail": "={{ $json.email }}",
        "subject": "={{ '[Casa da Paz] ' + ($json.funcao || 'Delegação') + ' — ' + ($json.titulo || '') }}",
        "emailType": "text",
        "message": "={{ $json.mensagem }}",
        "options": {}
      },
      "id": "d6-email",
      "name": "Send Email SMTP",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [980, 420],
      "credentials": {
        "smtp": {
          "id": "smtp-casadapaz",
          "name": "SMTP Casa da Paz"
        }
      },
      "notes": "Credencial N8N 'SMTP Casa da Paz' (host/user/pass). Defina SMTP_* no .env.production."
    },
    {
      "parameters": {},
      "id": "d7-noop",
      "name": "Outro canal (log)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [980, 300]
    }
  ],
  "connections": {
    "Webhook Tarefa Delegacao": {
      "main": [[{ "node": "Normalizar payload", "type": "main", "index": 0 }]]
    },
    "Normalizar payload": {
      "main": [
        [
          { "node": "Canal WhatsApp?", "type": "main", "index": 0 },
          { "node": "Canal E-mail?", "type": "main", "index": 0 }
        ]
      ]
    },
    "Canal WhatsApp?": {
      "main": [
        [{ "node": "Chatwoot WhatsApp", "type": "main", "index": 0 }],
        [{ "node": "Outro canal (log)", "type": "main", "index": 0 }]
      ]
    },
    "Canal E-mail?": {
      "main": [
        [{ "node": "Send Email SMTP", "type": "main", "index": 0 }],
        [{ "node": "Outro canal (log)", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": true,
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCredsSetupCompleted": true }
}
