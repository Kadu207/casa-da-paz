# Copie para .env.production na VPS (infra/) — NÃO commitar valores reais

DB_PASSWORD=gerar-senha-forte-aqui
JWT_SECRET=gerar-com-openssl-rand-hex-32

# Servidor compartilhado (80 ocupado pelo Excellence Dental)
NGINX_CONF=prod-internal.conf
# 127.0.0.1 = só localhost/túnel SSH
# 0.0.0.0 = cloudflared Docker alcança via 172.17.0.1:9080 (inovati-server)
# Com 0.0.0.0: OBRIGATÓRIO aplicar infra/scripts/harden-origin-9080.sh e
#              validar com infra/scripts/smoke-security-origin.sh
HOST_BIND=0.0.0.0
HOST_HTTP_PORT=9080

# Inventário secrets (não imprimir valores): ./scripts/check-prod-secrets.sh
# Obrigatórios fortes: DB_PASSWORD, JWT_SECRET
# CORS_ORIGIN é definido no compose prod (não use *)
# ASAAS_WEBHOOK_TOKEN: trocar antes de ativar Asaas (default abaixo é só sandbox)

# VPS dedicada (portas 80/443 livres) — comente as 3 linhas acima e use:
# NGINX_CONF=prod.conf
# HOST_BIND=0.0.0.0
# HOST_HTTP_PORT=80
# (e adicione 443:443 manualmente no compose se necessário)

# Opcional — Stripe deprecated (ADR-009); usar Asaas
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Asaas PSP — manter sandbox até chave $aact_prod_... ser fornecida
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=asaas-dev-webhook-token
# ASAAS_WALLET_ID=
# Opcional — Turnstile / Cloudflare Images
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# CF_ACCOUNT_ID=
# CF_IMAGES_API_TOKEN=

# --- Mensageria (Epic 012) — preencher antes de compose-prod-messaging ---
# Gerar: openssl rand -hex 32
# N8N_USER=admin
# N8N_PASSWORD=
# N8N_WEBHOOK_SECRET=
# N8N_WEBHOOK_URL=http://n8n:5678/
# CHATWOOT_SECRET=          # min 32 chars (openssl rand -hex 32)
# CHATWOOT_PUBLIC_URL=https://chat.casadapaz.inovatitech.com.br
# CHATWOOT_BIND=0.0.0.0   # inovati-server (cloudflared Swarm); 127.0.0.1 só se túnel local
# CHATWOOT_PORT=3001
# CHATWOOT_API_TOKEN=       # Profile → Access Token no Chatwoot (N8N enviar mensagens)
# N8N_URL=http://n8n:5678   # definido automaticamente pelo overlay messaging
