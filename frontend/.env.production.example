# Copie para frontend/.env.production antes do build (NÃO commitar valores reais)
# Usado por: npm run build  ou  .\scripts\build-frontend-prod.ps1

# Widget Chatwoot no portal público (Settings → Inboxes → Website → Configuration)
VITE_CHATWOOT_WEBSITE_TOKEN=
VITE_CHATWOOT_BASE_URL=https://casadapaz-chat.inovatitech.com.br

# Cloudflare Turnstile — site key (par da TURNSTILE_SECRET_KEY do backend na VPS)
# OBRIGATORIO se o backend tem TURNSTILE_SECRET_KEY, senao newsletter/agendamento dao 403
VITE_TURNSTILE_SITE_KEY=
