generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoPerfil {
  PRESIDENTE
  CONSULENTE
  MEDIUM
  DIRETORIA
  TESOURARIA
  CONSELHEIRO
  SUPORTE_TI
  FUNCIONARIO
}

enum SetorAcesso {
  SUPERVISOR
  ADMIN
  DIRETORIA
  FINANCEIRO
  TESOURARIA
  MARKETING
  RECEPCAO
  LIVRARIA
  MEDIUM
  SUPORTE
}

enum TipoContaFinanceira {
  CAIXA
  BANCO
  ASAAS
}

enum OrigemTransacao {
  MANUAL
  PDV
  EVENTO
  ECOMMERCE
  ASSINATURA
  IMPORT
  RECORRENCIA
  CONTA_PAGAR
  OFX
}

enum AsaasBillingType {
  BOLETO
  PIX
  CREDIT_CARD
  UNDEFINED
}

enum AsaasCobrancaStatus {
  PENDING
  RECEIVED
  CONFIRMED
  OVERDUE
  REFUNDED
  DELETED
  RECEIVED_IN_CASH
}

enum AsaasAssinaturaStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  CANCELLED
}

enum StatusContaPagar {
  PENDENTE
  PARCIAL
  PAGO
  CANCELADO
}

enum StatusParcela {
  PENDENTE
  PAGO
  CANCELADO
}

enum TipoContribuinte {
  PATROCINIO
  PADRINHO
}

enum StatusOfxMovimento {
  PENDENTE
  CONCILIADO
  IGNORADO
}

enum TipoTransacao {
  RECEITA
  DESPESA
}

enum CategoriaReceita {
  MENSALIDADE
  LIVRARIA
  DOACAO
  MANUTENCAO
  EVENTOS
  OFICINAS
}

enum CategoriaDespesa {
  ESTRUTURA_MANUTENCAO
  INSUMOS_TERREIRO
  CUSTOS_OPERACIONAIS
}

enum StatusTransacao {
  PENDENTE
  CONCLUIDO
}

enum StatusEvento {
  ABERTO
  ENCERRADO
}

enum TipoEvento {
  GIRA
  OFICINA
}

enum TipoPresenca {
  MEDIUM
  CONSULENTE
}

enum TipoProduto {
  LIVRO
  ERVA
  ARTIGO
}

enum TipoLivrariaConteudo {
  NOVIDADE
  DICA
}

enum CategoriaMaterialEstudo {
  ERVAS
  BANHOS
  DEFUMACAO
  OUTROS
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
}

enum CategoriaEstoqueCasa {
  RITUAL
  BEBIDA
  TABACO
  VELA
  LIMPEZA
  DESCARTAVEL
  OUTROS
}

enum UnidadeEstoqueCasa {
  UN
  CX
  PCT
  L
  ML
  KG
  G
}

enum TipoMovEstoqueCasa {
  ENTRADA
  SAIDA
  AJUSTE
}

enum StatusChecklistLimpeza {
  RASCUNHO
  CONCLUIDO
}

enum StatusAgendamento {
  PENDENTE
  CONFIRMADO
  CANCELADO
}

enum CanalAlerta {
  WHATSAPP
  EMAIL
  SISTEMA
}

enum StatusPedidoEcommerce {
  PENDENTE_PAGAMENTO
  PAGO
  CANCELADO
  EXPIRADO
}

enum TipoClienteEcommerce {
  PF
  PJ
}

model Pessoa {
  id            Int       @id @default(autoincrement())
  nomeCompleto  String    @map("nome_completo") @db.VarChar(150)
  telefone      String?   @db.VarChar(20)
  maiorDeIdade  Boolean   @default(true) @map("maior_de_idade")
  tipoPerfil    TipoPerfil @map("tipo_perfil")
  dataCadastro  DateTime  @default(now()) @map("data_cadastro")
  usuario       Usuario?
  transacoes    FinanceiroTransacao[]
  presencas     Presenca[]
  inscricoes    Inscricao[]
  agendamentos  AgendamentoPublico[]
  responsaveis  PessoaResponsavel[]
  asaasClientes AsaasCliente[]
  asaasAssinaturas AsaasAssinatura[]
  mensalidadePlano MensalidadePlano?

  @@map("pessoas")
}

model PessoaResponsavel {
  id           Int      @id @default(autoincrement())
  pessoaId     Int      @map("pessoa_id")
  nomeCompleto String   @map("nome_completo") @db.VarChar(150)
  telefone     String?  @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at")

  pessoa Pessoa @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@index([pessoaId])
  @@map("pessoa_responsaveis")
}

model Usuario {
  id              Int         @id @default(autoincrement())
  pessoaId        Int         @unique @map("pessoa_id")
  login           String      @unique @db.VarChar(50)
  senhaHash       String      @map("senha_hash") @db.VarChar(255)
  setorAcesso     SetorAcesso @map("setor_acesso")
  ativo           Boolean     @default(true)
  /** Seed / reset administrativo: bloqueia API até PUT /auth/me/senha */
  deveTrocarSenha Boolean     @default(false) @map("deve_trocar_senha")
  pessoa       Pessoa      @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  fechamentosFinanceiros FinanceiroFechamentoMensal[]
  policy       UsuarioPolicy?
  gruposLimpezaResponsavel GrupoLimpeza[]            @relation("GrupoLimpezaResponsavel")
  movimentacoesEstoqueCasa MovimentacaoEstoqueCasa[]
  checklistsCriados        ChecklistLimpeza[]        @relation("ChecklistCriadoPor")

  @@map("usuarios")
}

/// Overrides de RBAC configurados pelo SUPERVISOR (recurso → read | write | own | none)
model UsuarioPolicy {
  id              Int      @id @default(autoincrement())
  usuarioId       Int      @unique @map("usuario_id")
  grants          Json     @default("{}")
  atualizadoPorId Int?     @map("atualizado_por_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  usuario         Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("usuario_policies")
}

model ContaFinanceira {
  id            Int                 @id @default(autoincrement())
  nome          String              @db.VarChar(100)
  tipo          TipoContaFinanceira
  saldoInicial  Decimal             @default(0) @map("saldo_inicial") @db.Decimal(12, 2)
  ativa         Boolean             @default(true)
  asaasWalletId String?             @map("asaas_wallet_id") @db.VarChar(80)
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  transacoes    FinanceiroTransacao[]
  ofxImports    OfxImport[]

  @@map("contas_financeiras")
}

model CentroCusto {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique @db.VarChar(30)
  nome      String   @db.VarChar(100)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  transacoes FinanceiroTransacao[]
  orcamentos OrcamentoLinha[]
  contasPagar ContaPagar[]

  @@map("centros_custo")
}

model Fornecedor {
  id         Int      @id @default(autoincrement())
  nome       String   @db.VarChar(150)
  documento  String?  @db.VarChar(18)
  telefone   String?  @db.VarChar(20)
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  contasPagar ContaPagar[]

  @@map("fornecedores")
}

/// Patrocínios e padrinhos — contribuição periódica (cadastro tesouraria)
model Contribuinte {
  id         Int              @id @default(autoincrement())
  tipo       TipoContribuinte
  nome       String           @db.VarChar(150)
  valor      Decimal          @db.Decimal(12, 2)
  telefone   String?          @db.VarChar(20)
  ativo      Boolean          @default(true)
  observacao String?
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  @@index([tipo, ativo])
  @@map("contribuintes")
}

model ContaPagar {
  id            Int              @id @default(autoincrement())
  fornecedorId  Int?             @map("fornecedor_id")
  centroCustoId Int?             @map("centro_custo_id")
  descricao     String           @db.VarChar(200)
  categoria     String           @db.VarChar(50)
  valorTotal    Decimal          @map("valor_total") @db.Decimal(12, 2)
  vencimento    DateTime         @db.Date
  status        StatusContaPagar @default(PENDENTE)
  observacoes   String?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  fornecedor    Fornecedor?      @relation(fields: [fornecedorId], references: [id])
  centroCusto   CentroCusto?     @relation(fields: [centroCustoId], references: [id])
  parcelas      ContaPagarParcela[]

  @@index([status])
  @@index([vencimento])
  @@map("contas_pagar")
}

model ContaPagarParcela {
  id           Int           @id @default(autoincrement())
  contaPagarId Int           @map("conta_pagar_id")
  numero       Int
  valor        Decimal       @db.Decimal(12, 2)
  vencimento   DateTime      @db.Date
  status       StatusParcela @default(PENDENTE)
  pagoEm       DateTime?     @map("pago_em")
  transacaoId  Int?          @unique @map("transacao_id")
  contaPagar   ContaPagar    @relation(fields: [contaPagarId], references: [id], onDelete: Cascade)
  transacao    FinanceiroTransacao? @relation(fields: [transacaoId], references: [id])

  @@unique([contaPagarId, numero])
  @@index([status, vencimento])
  @@map("contas_pagar_parcelas")
}

model MensalidadePlano {
  id             Int       @id @default(autoincrement())
  pessoaId       Int       @map("pessoa_id")
  valor          Decimal   @db.Decimal(10, 2)
  diaVencimento  Int       @map("dia_vencimento")
  ativo          Boolean   @default(true)
  proximaGeracao DateTime? @map("proxima_geracao") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  pessoa         Pessoa    @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@unique([pessoaId])
  @@index([ativo])
  @@map("mensalidade_planos")
}

model OrcamentoLinha {
  id             Int           @id @default(autoincrement())
  ano            Int
  mes            Int
  tipo           TipoTransacao
  categoria      String        @db.VarChar(50)
  centroCustoId  Int?          @map("centro_custo_id")
  valorPlanejado Decimal       @map("valor_planejado") @db.Decimal(12, 2)
  centroCusto    CentroCusto?  @relation(fields: [centroCustoId], references: [id])

  @@unique([ano, mes, tipo, categoria, centroCustoId])
  @@map("orcamento_linhas")
}

model OfxImport {
  id         Int              @id @default(autoincrement())
  contaId    Int              @map("conta_id")
  filename   String           @db.VarChar(200)
  importedAt DateTime         @default(now()) @map("imported_at")
  qtd        Int              @default(0)
  conta      ContaFinanceira  @relation(fields: [contaId], references: [id])
  movimentos OfxMovimento[]

  @@map("ofx_imports")
}

model OfxMovimento {
  id          Int                @id @default(autoincrement())
  importId    Int                @map("import_id")
  fitId       String             @unique @map("fit_id") @db.VarChar(120)
  data        DateTime           @db.Date
  valor       Decimal            @db.Decimal(12, 2)
  tipo        TipoTransacao
  memo        String?
  status      StatusOfxMovimento @default(PENDENTE)
  transacaoId Int?               @unique @map("transacao_id")
  import      OfxImport          @relation(fields: [importId], references: [id], onDelete: Cascade)
  transacao   FinanceiroTransacao? @relation(fields: [transacaoId], references: [id])

  @@index([status])
  @@index([data])
  @@map("ofx_movimentos")
}

model FinanceiroTransacao {
  id                  Int              @id @default(autoincrement())
  pessoaId            Int?             @map("pessoa_id")
  contaId             Int?             @map("conta_id")
  centroCustoId       Int?             @map("centro_custo_id")
  tipo                TipoTransacao
  categoria           String           @db.VarChar(50)
  valor               Decimal          @db.Decimal(10, 2)
  dataTransacao       DateTime         @map("data_transacao") @db.Date
  vencimento          DateTime?        @db.Date
  status              StatusTransacao
  observacoes         String?
  origem              OrigemTransacao  @default(MANUAL)
  asaasPaymentId      String?          @map("asaas_payment_id") @db.VarChar(80)
  asaasSubscriptionId String?          @map("asaas_subscription_id") @db.VarChar(80)
  pessoa              Pessoa?          @relation(fields: [pessoaId], references: [id])
  conta               ContaFinanceira? @relation(fields: [contaId], references: [id])
  centroCusto         CentroCusto?     @relation(fields: [centroCustoId], references: [id])
  asaasCobrancas      AsaasCobranca[]
  parcelaPagar        ContaPagarParcela?
  ofxMovimento        OfxMovimento?

  @@index([dataTransacao])
  @@index([vencimento])
  @@index([pessoaId])
  @@index([contaId])
  @@index([centroCustoId])
  @@index([asaasPaymentId])
  @@map("financeiro_transacoes")
}

model FinanceiroFechamentoMensal {
  id            Int      @id @default(autoincrement())
  ano           Int
  mes           Int
  receitasTotal Decimal  @map("receitas_total") @db.Decimal(12, 2)
  despesasTotal Decimal  @map("despesas_total") @db.Decimal(12, 2)
  saldo         Decimal  @db.Decimal(12, 2)
  pendentesQtd  Int      @map("pendentes_qtd")
  atrasadosQtd  Int      @map("atrasados_qtd")
  observacoes   String?
  fechadoPorId  Int      @map("fechado_por_id")
  fechadoEm     DateTime @default(now()) @map("fechado_em")
  fechadoPor    Usuario  @relation(fields: [fechadoPorId], references: [id])

  @@unique([ano, mes])
  @@map("financeiro_fechamentos_mensais")
}

model Evento {
  id            Int           @id @default(autoincrement())
  nomeEvento    String        @map("nome_evento") @db.VarChar(100)
  dataEvento    DateTime      @map("data_evento") @db.Date
  tipo          TipoEvento    @default(GIRA)
  status        StatusEvento  @default(ABERTO)
  capacidadeMax Int?          @map("capacidade_max")
  visualizacoes Int           @default(0)
  presencas     Presenca[]
  inscricoes    Inscricao[]

  @@index([tipo, status, dataEvento])
  @@map("eventos")
}

model Presenca {
  id               Int          @id @default(autoincrement())
  eventoId         Int          @map("evento_id")
  pessoaId         Int          @map("pessoa_id")
  tipoPresenca     TipoPresenca @map("tipo_presenca")
  nomeResponsavel  String?      @map("nome_responsavel") @db.VarChar(150)
  horarioChegada   DateTime     @default(now()) @map("horario_chegada")
  evento           Evento       @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  pessoa           Pessoa       @relation(fields: [pessoaId], references: [id])

  @@unique([eventoId, pessoaId])
  @@map("presencas")
}

model Produto {
  id                 Int                  @id @default(autoincrement())
  nome               String               @db.VarChar(150)
  tipo               TipoProduto
  preco              Decimal              @db.Decimal(10, 2)
  estoqueAtual       Int                  @default(0) @map("estoque_atual")
  publicadoEcommerce Boolean              @default(true) @map("publicado_ecommerce")
  descricaoEcommerce String?              @map("descricao_ecommerce")
  movimentacoes      EstoqueMovimentacao[]
  itensPedido        EcommerceItemPedido[]
  conteudos          LivrariaConteudo[]

  @@map("produtos")
}

model LivrariaConteudo {
  id        Int                  @id @default(autoincrement())
  tipo      TipoLivrariaConteudo
  titulo    String               @db.VarChar(150)
  texto     String
  produtoId Int?                 @map("produto_id")
  ordem     Int                  @default(0)
  publicado Boolean              @default(true)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")
  produto   Produto?             @relation(fields: [produtoId], references: [id], onDelete: SetNull)

  @@index([tipo, publicado, ordem])
  @@map("livraria_conteudos")
}

/// Materiais de estudo públicos (ervas, banhos, defumação) — edição MARKETING
model MaterialEstudo {
  id         Int                     @id @default(autoincrement())
  slug       String                  @unique @db.VarChar(120)
  categoria  CategoriaMaterialEstudo
  titulo     String                  @db.VarChar(150)
  resumo     String                  @db.VarChar(400)
  corpo      String
  imagemUrl  String?                 @map("imagem_url") @db.VarChar(500)
  ordem      Int                     @default(0)
  publicado  Boolean                 @default(false)
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")

  @@index([publicado, categoria, ordem])
  @@map("materiais_estudo")
}

model EstoqueMovimentacao {
  id           Int            @id @default(autoincrement())
  produtoId    Int            @map("produto_id")
  tipo         TipoMovimentacao
  quantidade   Int
  transacaoId  Int?           @map("transacao_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  produto      Produto        @relation(fields: [produtoId], references: [id])

  @@map("estoque_movimentacoes")
}

model Inscricao {
  id              Int             @id @default(autoincrement())
  eventoId        Int             @map("evento_id")
  pessoaId        Int             @map("pessoa_id")
  valor           Decimal         @db.Decimal(10, 2)
  statusPagamento StatusTransacao @map("status_pagamento")
  vencimento      DateTime?       @db.Date
  evento          Evento          @relation(fields: [eventoId], references: [id])
  pessoa          Pessoa          @relation(fields: [pessoaId], references: [id])
  asaasCobrancas  AsaasCobranca[]

  @@unique([eventoId, pessoaId])
  @@map("inscricoes")
}

model AgendamentoPublico {
  id              Int               @id @default(autoincrement())
  protocolo       String            @unique @db.VarChar(32)
  nome            String            @db.VarChar(150)
  telefone        String            @db.VarChar(20)
  dataPreferida   DateTime?         @map("data_preferida") @db.Date
  observacao      String?
  status          StatusAgendamento @default(PENDENTE)
  pessoaId        Int?              @map("pessoa_id")
  aceiteLgpdEm    DateTime?         @map("aceite_lgpd_em")
  aceiteLgpdVersao String?          @map("aceite_lgpd_versao") @db.VarChar(20)
  createdAt       DateTime          @default(now()) @map("created_at")
  pessoa          Pessoa?           @relation(fields: [pessoaId], references: [id])

  @@map("agendamentos_publicos")
}

model NewsletterInscrito {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(150)
  nome      String?  @db.VarChar(150)
  locale    String   @default("pt-BR") @db.VarChar(10)
  ativo     Boolean  @default(true)
  aceiteLgpdEm     DateTime? @map("aceite_lgpd_em")
  aceiteLgpdVersao String?   @map("aceite_lgpd_versao") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("newsletter_inscritos")
}

model AdminAuditLog {
  id           Int      @id @default(autoincrement())
  usuarioId    Int?     @map("usuario_id")
  login        String?  @db.VarChar(50)
  setor        String?  @db.VarChar(50)
  metodo       String?  @db.VarChar(10)
  recurso      String?  @db.VarChar(60)
  acao         String?  @db.VarChar(40)
  entidadeTipo String?  @map("entidade_tipo") @db.VarChar(60)
  entidadeId   String?  @map("entidade_id") @db.VarChar(80)
  statusHttp   Int?     @map("status_http")
  sucesso      Boolean? @default(true)
  detalhe      Json?
  rota         String   @db.VarChar(120)
  motivo       String?
  ip           String?  @db.VarChar(45)
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([usuarioId, createdAt])
  @@index([recurso, createdAt])
  @@index([sucesso, createdAt])
  @@map("admin_audit_log")
}

model Alerta {
  id          Int         @id @default(autoincrement())
  tipo        String      @db.VarChar(50)
  mensagem    String
  pessoaId    Int?        @map("pessoa_id")
  canal       CanalAlerta
  disparado   Boolean     @default(false)
  createdAt   DateTime    @default(now()) @map("created_at")

  @@map("alertas")
}

model EcommerceCliente {
  id            Int                   @id @default(autoincrement())
  tipo          TipoClienteEcommerce
  nomeCompleto  String                @map("nome_completo") @db.VarChar(150)
  cpf           String?               @unique @db.VarChar(14)
  cnpj          String?               @unique @db.VarChar(18)
  email         String                @db.VarChar(150)
  telefone      String?               @db.VarChar(20)
  cep           String                @db.VarChar(9)
  logradouro    String                @db.VarChar(200)
  numero        String                @db.VarChar(20)
  complemento   String?               @db.VarChar(100)
  bairro        String                @db.VarChar(100)
  cidade        String                @db.VarChar(100)
  estado        String                @db.VarChar(2)
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  pedidos       EcommercePedido[]
  asaasClientes AsaasCliente[]

  @@map("ecommerce_clientes")
}

model EcommercePedido {
  id               Int                    @id @default(autoincrement())
  protocolo        String                 @unique @db.VarChar(32)
  clienteId        Int                    @map("cliente_id")
  status           StatusPedidoEcommerce  @default(PENDENTE_PAGAMENTO)
  valorTotal       Decimal                @map("valor_total") @db.Decimal(10, 2)
  asaasPaymentId   String?                @map("asaas_payment_id") @db.VarChar(80)
  asaasInvoiceUrl  String?                @map("asaas_invoice_url") @db.VarChar(500)
  aceiteLgpdEm     DateTime?              @map("aceite_lgpd_em")
  aceiteLgpdVersao String?                @map("aceite_lgpd_versao") @db.VarChar(20)
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  cliente          EcommerceCliente       @relation(fields: [clienteId], references: [id])
  itens            EcommerceItemPedido[]
  asaasCobrancas   AsaasCobranca[]

  @@index([status])
  @@index([createdAt])
  @@index([asaasPaymentId])
  @@map("ecommerce_pedidos")
}

model AsaasCliente {
  id                 Int               @id @default(autoincrement())
  asaasCustomerId    String            @unique @map("asaas_customer_id") @db.VarChar(80)
  pessoaId           Int?              @map("pessoa_id")
  ecommerceClienteId Int?              @map("ecommerce_cliente_id")
  cpfCnpj            String?           @map("cpf_cnpj") @db.VarChar(18)
  email              String?           @db.VarChar(150)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  pessoa             Pessoa?           @relation(fields: [pessoaId], references: [id])
  ecommerceCliente   EcommerceCliente? @relation(fields: [ecommerceClienteId], references: [id])

  @@index([pessoaId])
  @@index([ecommerceClienteId])
  @@map("asaas_clientes")
}

model AsaasCobranca {
  id              Int                 @id @default(autoincrement())
  asaasPaymentId  String              @unique @map("asaas_payment_id") @db.VarChar(80)
  status          AsaasCobrancaStatus @default(PENDING)
  billingType     AsaasBillingType    @map("billing_type")
  valor           Decimal             @db.Decimal(10, 2)
  vencimento      DateTime            @db.Date
  invoiceUrl      String?             @map("invoice_url") @db.VarChar(500)
  pixQrCode       String?             @map("pix_qr_code")
  pixCopiaCola    String?             @map("pix_copia_cola")
  externalRef     String?             @map("external_ref") @db.VarChar(120)
  transacaoId     Int?                @map("transacao_id")
  pedidoId        Int?                @map("pedido_id")
  inscricaoId     Int?                @map("inscricao_id")
  assinaturaId    Int?                @map("assinatura_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  transacao       FinanceiroTransacao? @relation(fields: [transacaoId], references: [id])
  pedido          EcommercePedido?     @relation(fields: [pedidoId], references: [id])
  inscricao       Inscricao?           @relation(fields: [inscricaoId], references: [id])
  assinatura      AsaasAssinatura?     @relation(fields: [assinaturaId], references: [id])

  @@index([status])
  @@index([transacaoId])
  @@index([pedidoId])
  @@index([inscricaoId])
  @@map("asaas_cobrancas")
}

model AsaasAssinatura {
  id                    Int                   @id @default(autoincrement())
  asaasSubscriptionId   String                @unique @map("asaas_subscription_id") @db.VarChar(80)
  pessoaId              Int                   @map("pessoa_id")
  valor                 Decimal               @db.Decimal(10, 2)
  cycle                 String                @default("MONTHLY") @db.VarChar(20)
  billingType           AsaasBillingType      @map("billing_type")
  status                AsaasAssinaturaStatus @default(ACTIVE)
  nextDueDate           DateTime?             @map("next_due_date") @db.Date
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  pessoa                Pessoa                @relation(fields: [pessoaId], references: [id])
  cobrancas             AsaasCobranca[]

  @@index([pessoaId])
  @@index([status])
  @@map("asaas_assinaturas")
}

model AsaasWebhookEvent {
  id          Int      @id @default(autoincrement())
  eventId     String   @unique @map("event_id") @db.VarChar(120)
  eventType   String   @map("event_type") @db.VarChar(80)
  payload     Json
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("asaas_webhook_events")
}

model EcommerceItemPedido {
  id            Int             @id @default(autoincrement())
  pedidoId      Int             @map("pedido_id")
  produtoId     Int             @map("produto_id")
  quantidade    Int
  precoUnitario Decimal         @map("preco_unitario") @db.Decimal(10, 2)
  pedido        EcommercePedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto       Produto         @relation(fields: [produtoId], references: [id])

  @@map("ecommerce_itens_pedido")
}

/// Almoxarifado primário — insumos de funcionamento / ritualística (ADR-010)
model ItemEstoqueCasa {
  id             Int                      @id @default(autoincrement())
  nome           String                   @db.VarChar(150)
  categoria      CategoriaEstoqueCasa
  unidade        UnidadeEstoqueCasa       @default(UN)
  estoqueAtual   Int                      @default(0) @map("estoque_atual")
  estoqueMinimo  Int                      @default(0) @map("estoque_minimo")
  ativo          Boolean                  @default(true)
  observacao     String?                  @db.VarChar(500)
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  movimentacoes  MovimentacaoEstoqueCasa[]
  checklistItens ChecklistLimpezaItem[]

  @@unique([nome, categoria])
  @@index([ativo, categoria])
  @@map("itens_estoque_casa")
}

model MovimentacaoEstoqueCasa {
  id          Int                 @id @default(autoincrement())
  itemId      Int                 @map("item_id")
  tipo        TipoMovEstoqueCasa
  quantidade  Int
  saldoApos   Int                 @map("saldo_apos")
  motivo      String?             @db.VarChar(300)
  usuarioId   Int                 @map("usuario_id")
  checklistId Int?                @map("checklist_id")
  createdAt   DateTime            @default(now()) @map("created_at")
  item        ItemEstoqueCasa     @relation(fields: [itemId], references: [id])
  usuario     Usuario             @relation(fields: [usuarioId], references: [id])
  checklist   ChecklistLimpeza?   @relation(fields: [checklistId], references: [id], onDelete: SetNull)

  @@index([itemId, createdAt])
  @@index([createdAt])
  @@map("movimentacoes_estoque_casa")
}

model GrupoLimpeza {
  id                   Int                @id @default(autoincrement())
  nome                 String             @db.VarChar(120)
  ativo                Boolean            @default(true)
  responsavelUsuarioId Int                @map("responsavel_usuario_id")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  responsavel          Usuario            @relation("GrupoLimpezaResponsavel", fields: [responsavelUsuarioId], references: [id])
  checklists           ChecklistLimpeza[]

  @@index([ativo])
  @@index([responsavelUsuarioId])
  @@map("grupos_limpeza")
}

model ChecklistLimpeza {
  id                Int                     @id @default(autoincrement())
  grupoId           Int                     @map("grupo_id")
  competencia       DateTime                @db.Date
  status            StatusChecklistLimpeza  @default(RASCUNHO)
  observacao        String?                 @db.VarChar(500)
  criadoPorUsuarioId Int                    @map("criado_por_usuario_id")
  concluidoEm       DateTime?               @map("concluido_em")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  grupo             GrupoLimpeza            @relation(fields: [grupoId], references: [id])
  criadoPor         Usuario                 @relation("ChecklistCriadoPor", fields: [criadoPorUsuarioId], references: [id])
  itens             ChecklistLimpezaItem[]
  movimentacoes     MovimentacaoEstoqueCasa[]

  @@index([grupoId, competencia])
  @@index([status])
  @@map("checklists_limpeza")
}

model ChecklistLimpezaItem {
  id              Int               @id @default(autoincrement())
  checklistId     Int               @map("checklist_id")
  itemId          Int               @map("item_id")
  quantidadeBaixa Int               @default(0) @map("quantidade_baixa")
  conferido       Boolean           @default(false)
  checklist       ChecklistLimpeza  @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  item            ItemEstoqueCasa   @relation(fields: [itemId], references: [id])

  @@unique([checklistId, itemId])
  @@map("checklist_limpeza_itens")
}
